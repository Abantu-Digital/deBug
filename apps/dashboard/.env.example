# ---------- Which database to read ----------
# demo      → in-memory sample data, no cloud needed (default)
# firestore → Firebase / Google Cloud Firestore
# dynamodb  → AWS DynamoDB
DEBUG_STORE=demo

# Firestore: point at a READ-ONLY service account (roles/datastore.viewer).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.readonly.json
# DEBUG_FIRESTORE_ROOT=debug_apps

# DynamoDB: uses the normal AWS credential chain (profile, SSO, instance role).
# Give it a read-only policy on the deBug table.
# AWS_REGION=af-south-1
# AWS_PROFILE=debug-readonly
# DEBUG_DYNAMO_TABLE=debug

# ---------- Login ----------
# Comma-separated email=hash pairs. Generate a hash with:  pnpm --filter @debugkit/dashboard hash-password
# DEBUG_DASHBOARD_USERS=you@company.com=scrypt.<salt>.<hash>

# Signs session cookies. At least 32 random characters:  openssl rand -hex 32
# DEBUG_SESSION_SECRET=

# Optional bearer token for agents / scripts calling /api/* without a browser session.
# DEBUG_API_TOKEN=

# Severity thresholds (occurrences in the last 24h)
# DEBUG_SEVERITY_CRITICAL=100
# DEBUG_SEVERITY_HIGH=25
# DEBUG_SEVERITY_MEDIUM=5

# Session cookie name. Behind Firebase Hosting it must be __session (the only cookie Hosting forwards).
# DEBUG_COOKIE_NAME=debug_session
