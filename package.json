{
  "name": "debug-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "pack:local": "node scripts/pack-local.mjs",
    "changeset": "changeset",
    "release": "pnpm build && pnpm --filter @debugkit/dashboard build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
