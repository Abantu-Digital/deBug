{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@debugkit/dashboard",
        "dev"
      ],
      "port": 4400
    },
    {
      "name": "vite-react-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "examples/vite-react",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "tanstack-start-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "examples/tanstack-start",
        "run",
        "dev"
      ],
      "port": 5174
    }
  ]
}
